# --- Telegram ----------------------------------------------------------
# Токен от @BotFather
BOT_TOKEN=
# Чат, куда слать нарезки и где работают команды. Оставь пустым, запусти бота,
# добавь его в группу и напиши /start: бот ответит id чата, впиши его сюда.
CHAT_ID=

# --- Стримеры ----------------------------------------------------------
# Начальный список (логины Twitch через запятую). Дальше управляется из чата:
# /add, /remove, /list
STREAMERS=

# Резать только эти игры: точные названия категорий Twitch через запятую.
# Пусто = любые игры. Название видно в /list, когда стример в эфире.
GAMES=Grand Theft Auto VI

# --- Оценка нейросетью (необязательно) ---------------------------------
# Без ключа бот шлёт все найденные моменты без оценки.
# DeepSeek: ключ с platform.deepseek.com
DEEPSEEK_API_KEY=
# Модель; пусто = deepseek-flash
JUDGE_MODEL=
# Вместо DeepSeek можно Claude: впиши ANTHROPIC_API_KEY и JUDGE_PROVIDER=anthropic
# Клипы с оценкой ниже этой не отправляются
MIN_SCORE=6

# Расшифровка речи на CPU (нужен pip install -e ".[whisper]").
# Пусто = выключено. Варианты: tiny, base, small
WHISPER_MODEL=
WHISPER_LANGUAGE=ru

# --- Детектор ----------------------------------------------------------
# Во сколько раз чат должен ускориться относительно обычного темпа
CHAT_MULT=3.0
# Минимум сообщений за окно CHAT_WINDOW секунд (отсекает маленькие чаты)
CHAT_MIN_MESSAGES=15
CHAT_WINDOW=10
# Пауза между клипами одного стримера, секунды
COOLDOWN_SECONDS=90
# Минимальный всплеск громкости (0 = не проверять)
AUDIO_MIN_MULT=0

# --- Клип --------------------------------------------------------------
# Сколько секунд до и после всплеска попадает в клип
PRE_SECONDS=30
POST_SECONDS=15
# Кнопки подрезки: сколько часов хранить исходник клипа (0 = без кнопок)
# и сколько секунд запаса держать до и после клипа
KEEP_SOURCE_HOURS=24
TRIM_MARGIN_BEFORE=30
TRIM_MARGIN_AFTER=30
# 1 = вертикальное 9:16 с размытым фоном, 0 = как в оригинале
VERTICAL=1
QUALITY=720p,720p60,480p,best
TIMEZONE=Europe/Moscow
DATA_DIR=data
