# --- WEB MODE (works without my.telegram.org) -------------------------
# Bot token from @BotFather + your numeric user id (from @userinfobot).
# The bot must be /start-ed by you once. Run: python -m tg_lead_radar.web
BOT_TOKEN=
NOTIFY_USER_ID=
# Public channels only (chats have no t.me/s preview)
WEB_CHANNELS=Remoteit,digitaltender,webfrl
POLL_INTERVAL_SECONDS=300

# --- USERBOT MODE (needs my.telegram.org credentials) -----------------
# From https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=your-api-hash-here

# Channels/chats to watch, comma-separated, no @
CHANNELS=Remoteit,digitaltender,webfrl,freelead,slavelancers

# Where lead cards go; "me" = Saved Messages
NOTIFY_CHAT=me

SESSION_PATH=data/radar
DB_PATH=data/seen.db
