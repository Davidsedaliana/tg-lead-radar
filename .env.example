# --- WEB MODE (works without my.telegram.org) -------------------------
# Bot token from @BotFather + your numeric user id (from @userinfobot).
# The bot must be /start-ed by you once. Run: python -m tg_lead_radar.web
BOT_TOKEN=
NOTIFY_USER_ID=
# Public channels only (chats have no t.me/s preview)
WEB_CHANNELS=Remoteit,digitaltender,webfrl
POLL_INTERVAL_SECONDS=300

# --- USERBOT MODE (needs my.telegram.org credentials) -----------------
# From https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=your-api-hash-here

# Channels/chats to watch, comma-separated, no @
CHANNELS=Remoteit,digitaltender,webfrl,freelead,slavelancers

# Where lead cards go; "me" = Saved Messages
NOTIFY_CHAT=me

SESSION_PATH=data/radar
DB_PATH=data/seen.db

# --- MODES (userbot) ----------------------------------------------------
# One process serves both modes on one session: a second process on the
# same session file would get "database is locked".
ORDERS_ENABLED=true
JOBS_ENABLED=false

# --- JOBS MODE: QA vacancies as raw data for an external agent, no LLM ---
# Telegram folder with vacancy channels (an emoji in its name is fine)
JOBS_FOLDER=Вакансии
# Extra channels, comma-separated, no @; the only source if the folder is missing
JOBS_CHANNELS=
# History loaded on the first read of a channel
JOBS_BACKFILL_DAYS=14
# vacancies.jsonl, YYYY-MM-DD.md digests and the channel report go here
JOBS_EXPORT_DIR=data/jobs
JOBS_DB_PATH=data/jobs.db
# Stems, anti-lists, dictionaries and thresholds (jobs mode + discover)
JOBS_CONFIG_PATH=jobs.toml
# Cards about new vacancies in Saved Messages
JOBS_NOTIFY=false

# Second login for scripts/discover_channels.py, so it runs while the radar
# holds its own session: python scripts/login.py --session data/discover
DISCOVER_SESSION_PATH=data/discover
